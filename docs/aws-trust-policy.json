{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HcpTerraformOidc",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/app.terraform.io"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "app.terraform.io:aud": "aws.workload.identity"
        },
        "StringLike": {
          "app.terraform.io:sub": "organization:YOUR_HCP_ORGANIZATION:project:YOUR_HCP_PROJECT:workspace:YOUR_HCP_WORKSPACE:run_phase:*"
        }
      }
    }
  ]
}
