# Copy values into HCP Terraform workspace variables. Do not commit real secrets.
environment          = "demo"
name_prefix          = "multicloud"
container_image      = "ghcr.io/durgeshkumar1995/multicloud-demo:v1.0.0"
container_port       = 8080
health_check_path    = "/health"

aws_region           = "ap-south-1"
# Leave empty to resolve the latest official Canonical Ubuntu 24.04 image.
aws_ami_id           = ""
azure_location       = "centralindia"
azure_resource_group_name = "rg-multicloud-terraform"
gcp_project_id       = "multicloudproject-508411"
gcp_region           = "asia-south1"
gcp_zones            = ["asia-south1-a", "asia-south1-b"]

domain_name          = "multicloud.durgesh.space"
hosted_zone_id       = "Z03424422VGD13RVLRX4"
application_hostname = "app.multicloud.durgesh.space"

# Enable one provider at a time only after reviewing a saved plan.
enable_aws       = false
enable_azure     = false
enable_gcp       = false
enable_dns       = false
enable_databases = false

# Required before enable_azure=true.
azure_ssh_public_key = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"

# Required only when enable_databases=true; set as a sensitive HCP variable.
# database_admin_password = "REPLACE_IN_HCP_TERRAFORM"
